PORT=3000

# Conexion exclusiva de MySQL. No usar DATABASE_URL de FastAPI.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=iub_auxiliar
MYSQL_USER=root
MYSQL_PASSWORD=tu_password
MYSQL_CONNECTION_LIMIT=10

# Debe coincidir con la clave usada por api2026_iub.
JWT_SECRET_KEY=REEMPLAZAR_CON_LA_MISMA_CLAVE_DE_FASTAPI
JWT_ALGORITHM=HS256

# Se usara cuando Express consulte el estado del usuario en FastAPI.
FASTAPI_URL=http://127.0.0.1:8000
